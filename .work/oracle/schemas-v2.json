{
  "$defs": {
    "api_expectation": {
      "additionalProperties": false,
      "properties": {
        "core_never_returns": {
          "const": "PASS"
        },
        "forbidden_production_parameters": {
          "items": {
            "pattern": "^[a-z_]{1,40}(?![\\s\\S])",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "production_entry_point": {
          "const": "g1_production"
        },
        "production_parameters": {
          "items": {
            "const": "measurement_identity_sha256"
          },
          "minItems": 1,
          "type": "array"
        },
        "test_pass_vocabulary": {
          "const": "TEST_ONLY_PASS"
        }
      },
      "required": [
        "core_never_returns",
        "forbidden_production_parameters",
        "production_entry_point",
        "production_parameters",
        "test_pass_vocabulary"
      ],
      "type": "object"
    },
    "attempt_binding": {
      "additionalProperties": false,
      "properties": {
        "binding_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "entry_sequence": {
          "$ref": "#/$defs/pos"
        },
        "entry_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "g1_contract": {
          "const": "delsk.oracle-contract.v2"
        },
        "measured_source_sha": {
          "$ref": "#/$defs/hex40"
        },
        "measurement_identity_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "observed_head": {
          "$ref": "#/$defs/registry_head"
        },
        "repository": {
          "const": "definitely-stable/Shift-lab"
        },
        "run_attempt": {
          "$ref": "#/$defs/pos"
        },
        "run_id": {
          "$ref": "#/$defs/pos"
        },
        "schema": {
          "const": "delsk.oracle.attempt-binding.v1"
        }
      },
      "required": [
        "binding_sha256",
        "entry_sequence",
        "entry_sha256",
        "g1_contract",
        "measured_source_sha",
        "measurement_identity_sha256",
        "observed_head",
        "repository",
        "run_attempt",
        "run_id",
        "schema"
      ],
      "type": "object"
    },
    "attempt_disclosure": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "PRE",
            "BUNDLE",
            "MISSING"
          ]
        },
        "conformance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "entry_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "measurement_identity_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "outcome": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "COMPLETE",
                "COMPLETE_WITH_FAILURES",
                "INCOMPLETE",
                "INVALID"
              ]
            }
          ]
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "run_attempt": {
          "$ref": "#/$defs/pos"
        },
        "run_id": {
          "$ref": "#/$defs/pos"
        },
        "science_identity_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "sequence": {
          "$ref": "#/$defs/pos"
        },
        "violations": {
          "items": {
            "enum": [
              "BINDING_MISMATCH",
              "DUPLICATE_EXECUTION",
              "UNBOUND_MEASUREMENT"
            ]
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "class",
        "conformance",
        "entry_sha256",
        "measurement_identity_sha256",
        "outcome",
        "phase",
        "run_attempt",
        "run_id",
        "science_identity_sha256",
        "sequence",
        "violations"
      ],
      "type": "object"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "provider_api": {
          "const": "https://api.github.com"
        },
        "registry_ref": {
          "const": "refs/heads/delsk/registry"
        },
        "registry_remote": {
          "const": "https://github.com/definitely-stable/Shift-lab.git"
        },
        "repository": {
          "const": "definitely-stable/Shift-lab"
        },
        "results_root": {
          "const": ".work/results/DELSK-003-ORACLE-V2/"
        }
      },
      "required": [
        "provider_api",
        "registry_ref",
        "registry_remote",
        "repository",
        "results_root"
      ],
      "type": "object"
    },
    "bundle_projection": {
      "additionalProperties": false,
      "else": {
        "properties": {
          "conformance": {
            "type": "null"
          },
          "cost_projection_sha256": {
            "type": "null"
          },
          "measurement_identity_sha256": {
            "type": "null"
          },
          "run": {
            "type": "null"
          },
          "run_status": {
            "type": "null"
          },
          "sealed_commitments_sha256": {
            "type": "null"
          },
          "series_projection_sha256": {
            "type": "null"
          },
          "targets_sha256": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "bundle_verified": {
            "const": true
          }
        }
      },
      "properties": {
        "bundle_verified": {
          "type": "boolean"
        },
        "conformance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "cost_projection_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hex64"
            }
          ]
        },
        "measurement_identity_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hex64"
            }
          ]
        },
        "run": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bundle_run"
            }
          ]
        },
        "run_attempt": {
          "$ref": "#/$defs/pos"
        },
        "run_id": {
          "$ref": "#/$defs/pos"
        },
        "run_status": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "COMPLETE",
                "COMPLETE_WITH_FAILURES",
                "INCOMPLETE",
                "INVALID"
              ]
            }
          ]
        },
        "sealed_commitments_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hex64"
            }
          ]
        },
        "series_projection_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hex64"
            }
          ]
        },
        "targets_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hex64"
            }
          ]
        }
      },
      "required": [
        "bundle_verified",
        "conformance",
        "cost_projection_sha256",
        "measurement_identity_sha256",
        "run",
        "run_attempt",
        "run_id",
        "run_status",
        "sealed_commitments_sha256",
        "series_projection_sha256",
        "targets_sha256"
      ],
      "then": {
        "if": {
          "properties": {
            "run_status": {
              "const": "COMPLETE"
            }
          }
        },
        "properties": {
          "conformance": {
            "type": "boolean"
          },
          "measurement_identity_sha256": {
            "$ref": "#/$defs/hex64"
          },
          "run": {
            "$ref": "#/$defs/bundle_run"
          },
          "run_status": {
            "enum": [
              "COMPLETE",
              "COMPLETE_WITH_FAILURES",
              "INCOMPLETE",
              "INVALID"
            ]
          }
        },
        "then": {
          "properties": {
            "cost_projection_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "sealed_commitments_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "series_projection_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "targets_sha256": {
              "$ref": "#/$defs/hex64"
            }
          }
        }
      },
      "type": "object"
    },
    "bundle_run": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "definitely-stable/Shift-lab"
        },
        "run_attempt": {
          "$ref": "#/$defs/pos"
        },
        "run_id": {
          "$ref": "#/$defs/pos"
        },
        "sha": {
          "$ref": "#/$defs/hex40"
        },
        "workflow_ref": {
          "pattern": "^definitely-stable/Shift-lab/\\.github/workflows/oracle-pilot\\.yml@refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]{0,199}(?![\\s\\S])",
          "type": "string"
        },
        "workflow_sha": {
          "$ref": "#/$defs/hex40"
        }
      },
      "required": [
        "repository",
        "run_attempt",
        "run_id",
        "sha",
        "workflow_ref",
        "workflow_sha"
      ],
      "type": "object"
    },
    "change_review": {
      "additionalProperties": false,
      "properties": {
        "merge_commit_sha": {
          "$ref": "#/$defs/hex40"
        },
        "pull_request": {
          "$ref": "#/$defs/pos"
        }
      },
      "required": [
        "merge_commit_sha",
        "pull_request"
      ],
      "type": "object"
    },
    "code": {
      "enum": [
        "REGISTRY_INVALID",
        "REGISTRY_DUPLICATE",
        "REGISTRY_STALE",
        "REGISTRY_ROLLBACK",
        "EVIDENCE_ROOT_INVALID",
        "RUN_INVALID",
        "REPEAT_MISMATCH",
        "BINDING_MISMATCH",
        "UNBOUND_MEASUREMENT",
        "DUPLICATE_EXECUTION",
        "SERIES_INVALID",
        "SERIES_REPEAT_MISMATCH",
        "SERIES_TRANSITION_MISMATCH",
        "SERIES_FORK",
        "SERIES_REENTRY",
        "RUN_INCOMPLETE",
        "RUN_COMPLETE_WITH_FAILURES",
        "CONFORMANCE_OR_BUNDLE",
        "REPEAT_MISSING",
        "RESULT_MISSING",
        "SERIES_FAILURE",
        "SERIES_TRANSITION_MISSING",
        "SERIES_SUPERSEDED",
        "KAT_NOT_VERIFIED",
        "V2_NOT_ACTIVE"
      ]
    },
    "codec_ref": {
      "additionalProperties": false,
      "properties": {
        "codec_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])",
          "type": "string"
        },
        "options_sha256": {
          "$ref": "#/$defs/hex64"
        }
      },
      "required": [
        "codec_id",
        "options_sha256"
      ],
      "type": "object"
    },
    "commit": {
      "additionalProperties": false,
      "properties": {
        "ancestors": {
          "items": {
            "$ref": "#/$defs/hex40"
          },
          "type": "array",
          "uniqueItems": true
        },
        "sha": {
          "$ref": "#/$defs/hex40"
        }
      },
      "required": [
        "ancestors",
        "sha"
      ],
      "type": "object"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "commits": {
          "items": {
            "$ref": "#/$defs/commit"
          },
          "type": "array"
        },
        "kat_green": {
          "items": {
            "$ref": "#/$defs/hex40"
          },
          "type": "array",
          "uniqueItems": true
        },
        "main_head": {
          "$ref": "#/$defs/hex40"
        },
        "pull_requests": {
          "items": {
            "$ref": "#/$defs/pull_request"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/source"
          },
          "type": "array"
        }
      },
      "required": [
        "commits",
        "kat_green",
        "main_head",
        "pull_requests",
        "sources"
      ],
      "type": "object"
    },
    "environment_override": {
      "additionalProperties": false,
      "properties": {
        "kat_green": {
          "items": {
            "$ref": "#/$defs/hex40"
          },
          "type": "array",
          "uniqueItems": true
        },
        "pull_requests": {
          "items": {
            "$ref": "#/$defs/pull_request"
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "evaluator": {
      "additionalProperties": false,
      "properties": {
        "evaluator_source_sha": {
          "$ref": "#/$defs/hex40"
        },
        "g1_code_sha256": {
          "$ref": "#/$defs/hex64"
        }
      },
      "required": [
        "evaluator_source_sha",
        "g1_code_sha256"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/attempt_binding"
          },
          "type": "array"
        },
        "bundles": {
          "items": {
            "$ref": "#/$defs/bundle_projection"
          },
          "type": "array"
        },
        "foreign_paths": {
          "items": {
            "pattern": "^[^\\x00-\\x1f\\x7f]{1,600}(?![\\s\\S])",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "v1_root_keys": {
          "items": {
            "$ref": "#/$defs/run_key"
          },
          "type": "array"
        }
      },
      "required": [
        "bindings",
        "bundles",
        "foreign_paths",
        "v1_root_keys"
      ],
      "type": "object"
    },
    "expectation": {
      "additionalProperties": false,
      "properties": {
        "core_verdict": {
          "enum": [
            "SCIENTIFIC_PASS",
            "NOT_PASSED",
            "INVALID",
            "NOT_RUN",
            "NO_VERDICT"
          ]
        },
        "measurement_identity_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "record": {
          "$ref": "#/$defs/g1_record"
        }
      },
      "required": [
        "core_verdict",
        "measurement_identity_sha256",
        "record"
      ],
      "type": "object"
    },
    "external_checkpoint": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "head": {
          "$ref": "#/$defs/registry_head"
        },
        "locator": {
          "pattern": "^https://[!-~]{1,2000}(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "checkpoint_sha256",
        "head",
        "locator"
      ],
      "type": "object"
    },
    "g1_record": {
      "additionalProperties": false,
      "else": {
        "properties": {
          "evaluator": {
            "$ref": "#/$defs/evaluator"
          },
          "verdict": {
            "enum": [
              "PASS",
              "NOT_PASSED",
              "INVALID",
              "NOT_RUN",
              "NO_VERDICT"
            ]
          }
        }
      },
      "if": {
        "properties": {
          "authority": {
            "type": "null"
          }
        }
      },
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/attempt_disclosure"
          },
          "type": "array"
        },
        "authority": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/authority"
            }
          ]
        },
        "blockers": {
          "items": {
            "$ref": "#/$defs/code"
          },
          "type": "array",
          "uniqueItems": true
        },
        "evaluator": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/evaluator"
            }
          ]
        },
        "external_checkpoint": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/external_checkpoint"
            }
          ]
        },
        "g1_contract": {
          "const": "delsk.oracle-contract.v2"
        },
        "genesis_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hex64"
            }
          ]
        },
        "measurement_contract": {
          "const": "delsk.oracle-contract.v1"
        },
        "measurement_identity_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "record_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "registry_head": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/registry_head"
            }
          ]
        },
        "schema": {
          "const": "delsk.oracle.g1-record.v1"
        },
        "science_identity_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hex64"
            }
          ]
        },
        "series": {
          "items": {
            "$ref": "#/$defs/series_state"
          },
          "type": "array"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/transition_disclosure"
          },
          "type": "array"
        },
        "unbound_attempts": {
          "items": {
            "$ref": "#/$defs/unbound_attempt"
          },
          "type": "array"
        },
        "verdict": {
          "enum": [
            "PASS",
            "TEST_ONLY_PASS",
            "NOT_PASSED",
            "INVALID",
            "NOT_RUN",
            "NO_VERDICT"
          ]
        }
      },
      "required": [
        "attempts",
        "authority",
        "blockers",
        "evaluator",
        "external_checkpoint",
        "g1_contract",
        "genesis_sha256",
        "measurement_contract",
        "measurement_identity_sha256",
        "record_sha256",
        "registry_head",
        "schema",
        "science_identity_sha256",
        "series",
        "transitions",
        "unbound_attempts",
        "verdict"
      ],
      "then": {
        "properties": {
          "evaluator": {
            "type": "null"
          },
          "verdict": {
            "enum": [
              "TEST_ONLY_PASS",
              "NOT_PASSED",
              "INVALID",
              "NOT_RUN",
              "NO_VERDICT"
            ]
          }
        }
      },
      "type": "object"
    },
    "hex40": {
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])",
      "type": "string"
    },
    "hex64": {
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "measurement_identity_v1": {
      "description": "validated against v1 schemas.json $defs.run.properties.measurement_identity (closed there)",
      "type": "object"
    },
    "mutant": {
      "additionalProperties": false,
      "properties": {
        "defect": {
          "pattern": "^[^\\x00-\\x1f\\x7f]{1,600}(?![\\s\\S])",
          "type": "string"
        },
        "id": {
          "pattern": "^PM(0[1-9]|10)(?![\\s\\S])",
          "type": "string"
        },
        "killed_by": {
          "items": {
            "pattern": "^R(0[1-9]|1[0-9]|2[0-2])(\\.[a-e])?(?![\\s\\S])",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "survives_as": {
          "pattern": "^[^\\x00-\\x1f\\x7f]{1,600}(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "defect",
        "id",
        "killed_by",
        "survives_as"
      ],
      "type": "object"
    },
    "phase": {
      "enum": [
        "pilot",
        "reveal"
      ]
    },
    "pos": {
      "minimum": 1,
      "type": "integer"
    },
    "provider_job": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "success",
                "failure",
                "cancelled",
                "skipped",
                "timed_out"
              ]
            }
          ]
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()/-]{0,99}(?![\\s\\S])",
          "type": "string"
        },
        "started": {
          "type": "boolean"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/provider_step"
          },
          "type": "array"
        }
      },
      "required": [
        "conclusion",
        "name",
        "started",
        "steps"
      ],
      "type": "object"
    },
    "provider_observation": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provider_run"
            }
          ]
        },
        "run_attempt": {
          "$ref": "#/$defs/pos"
        },
        "run_id": {
          "$ref": "#/$defs/pos"
        },
        "schema": {
          "const": "delsk.oracle.provider-observation.v1"
        }
      },
      "required": [
        "run",
        "run_attempt",
        "run_id",
        "schema"
      ],
      "type": "object"
    },
    "provider_run": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "pattern": "^[a-z_]{1,64}(?![\\s\\S])",
          "type": "string"
        },
        "head_branch": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}(?![\\s\\S])",
          "type": "string"
        },
        "head_sha": {
          "$ref": "#/$defs/hex40"
        },
        "jobs": {
          "items": {
            "$ref": "#/$defs/provider_job"
          },
          "type": "array"
        },
        "latest_run_attempt": {
          "$ref": "#/$defs/pos"
        },
        "status": {
          "enum": [
            "queued",
